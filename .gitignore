# Ignore the entire data directory inside llama2.c
llama2.c/data/

# Ignore all python cache files anywhere
**/__pycache__/

# Ignore specific extensions inside llama2.c
llama2.c/*.bin


# Ignore specific folders
llama2.c/15M/
llama2.c/finetunes/

*.bin
*.pt
private/*.txt
*.list
