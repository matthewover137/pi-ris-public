**/objs/
kernel.img
*.elf
*.d
pi-baremetal/inference-server/*.o

# Compiled executables (no extension)
pi-baremetal/bootloader/unix-side/my-install

# Built libraries (regenerated by make)
pi-baremetal/libpi/libpi.a
pi-baremetal/libunix/libunix.a